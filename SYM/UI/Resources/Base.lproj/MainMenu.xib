<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="23504" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="23504"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="NSApplication">
            <connections>
                <outlet property="delegate" destination="app-delegate" id="app-delegate-outlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customObject id="app-delegate" customClass="AppDelegate" customModule="SYM" customModuleProvider="target"/>
        <menu title="Main Menu" systemMenu="main" id="main-menu">
            <items>
                <menuItem title="SYM" id="app-item">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="SYM" systemMenu="apple" id="app-menu">
                        <items>
                            <menuItem title="About SYM" id="about-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="showAboutPanel:" target="app-delegate" id="about-act"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="app-sep1"/>
                            <menuItem title="Settings…" keyEquivalent="," id="settings-item">
                                <connections>
                                    <action selector="showPreferences:" target="app-delegate" id="settings-act"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="app-sep2"/>
                            <menuItem title="Services" id="services-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <menu key="submenu" title="Services" systemMenu="services" id="services-menu"/>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="app-sep3"/>
                            <menuItem title="Hide SYM" keyEquivalent="h" id="hide-item">
                                <connections>
                                    <action selector="hide:" target="-1" id="hide-act"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Hide Others" keyEquivalent="h" id="hide-others">
                                <modifierMask key="keyEquivalentModifierMask" option="YES" command="YES"/>
                                <connections>
                                    <action selector="hideOtherApplications:" target="-1" id="hide-others-act"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Show All" id="show-all">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="unhideAllApplications:" target="-1" id="show-all-act"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="app-sep4"/>
                            <menuItem title="Quit SYM" keyEquivalent="q" id="quit-item">
                                <connections>
                                    <action selector="terminate:" target="-1" id="quit-act"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="File" id="file-item">
                    <menu key="submenu" title="File" id="file-menu">
                        <items>
                            <menuItem title="New" keyEquivalent="n" id="new-item">
                                <connections>
                                    <action selector="newDocument:" target="-1" id="new-act"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Open…" keyEquivalent="o" id="open-item">
                                <connections>
                                    <action selector="openDocument:" target="-1" id="open-act"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Open Recent" id="recent-item">
                                <menu key="submenu" title="Open Recent" systemMenu="recentDocuments" id="recent-menu">
                                    <items>
                                        <menuItem title="Clear Menu" id="clear-recent">
                                            <connections>
                                                <action selector="clearRecentDocuments:" target="-1" id="clear-recent-act"/>
                                            </connections>
                                        </menuItem>
                                    </items>
                                </menu>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="file-sep1"/>
                            <menuItem title="Close" keyEquivalent="w" id="close-item">
                                <connections>
                                    <action selector="performClose:" target="-1" id="close-act"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Save…" keyEquivalent="s" id="save-item">
                                <connections>
                                    <action selector="saveDocument:" target="-1" id="save-act"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Save As…" keyEquivalent="S" id="saveas-item">
                                <connections>
                                    <action selector="saveDocumentAs:" target="-1" id="saveas-act"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Edit" id="edit-item">
                    <menu key="submenu" title="Edit" id="edit-menu">
                        <items>
                            <menuItem title="Undo" keyEquivalent="z" id="undo-item">
                                <connections>
                                    <action selector="undo:" target="-1" id="undo-act"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Redo" keyEquivalent="Z" id="redo-item">
                                <connections>
                                    <action selector="redo:" target="-1" id="redo-act"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="edit-sep1"/>
                            <menuItem title="Cut" keyEquivalent="x" id="cut-item">
                                <connections>
                                    <action selector="cut:" target="-1" id="cut-act"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Copy" keyEquivalent="c" id="copy-item">
                                <connections>
                                    <action selector="copy:" target="-1" id="copy-act"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Paste" keyEquivalent="v" id="paste-item">
                                <connections>
                                    <action selector="paste:" target="-1" id="paste-act"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Select All" keyEquivalent="a" id="selectall-item">
                                <connections>
                                    <action selector="selectAll:" target="-1" id="selectall-act"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="edit-sep2"/>
                            <menuItem title="Find" id="find-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <menu key="submenu" title="Find" id="find-menu">
                                    <items>
                                        <menuItem title="Find…" tag="1" keyEquivalent="f" id="find-show">
                                            <connections>
                                                <action selector="performTextFinderAction:" target="-1" id="find-show-act"/>
                                            </connections>
                                        </menuItem>
                                        <menuItem title="Find and Replace…" tag="12" keyEquivalent="f" id="find-replace">
                                            <modifierMask key="keyEquivalentModifierMask" option="YES" command="YES"/>
                                            <connections>
                                                <action selector="performTextFinderAction:" target="-1" id="find-replace-act"/>
                                            </connections>
                                        </menuItem>
                                        <menuItem title="Find Next" tag="2" keyEquivalent="g" id="find-next">
                                            <connections>
                                                <action selector="performTextFinderAction:" target="-1" id="find-next-act"/>
                                            </connections>
                                        </menuItem>
                                        <menuItem title="Find Previous" tag="3" keyEquivalent="G" id="find-prev">
                                            <connections>
                                                <action selector="performTextFinderAction:" target="-1" id="find-prev-act"/>
                                            </connections>
                                        </menuItem>
                                        <menuItem title="Use Selection for Find" tag="7" keyEquivalent="e" id="find-use-selection">
                                            <connections>
                                                <action selector="performTextFinderAction:" target="-1" id="find-use-selection-act"/>
                                            </connections>
                                        </menuItem>
                                        <menuItem title="Jump to Selection" keyEquivalent="j" id="find-jump">
                                            <connections>
                                                <action selector="centerSelectionInVisibleArea:" target="-1" id="find-jump-act"/>
                                            </connections>
                                        </menuItem>
                                    </items>
                                </menu>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Symbol" id="symbol-item">
                    <menu key="submenu" title="Symbol" id="symbol-menu">
                        <items>
                            <menuItem title="Symbolicate" keyEquivalent="r" id="symbolicate-item">
                                <connections>
                                    <action selector="symbolicate:" target="-1" id="symbolicate-act"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="symbol-sep"/>
                            <menuItem title="Download Script…" id="script-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="showDownloadScript:" target="app-delegate" id="script-act"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="View" id="view-item">
                    <menu key="submenu" title="View" id="view-menu">
                        <items>
                            <menuItem title="Zoom In" keyEquivalent="+" id="zoomin-item">
                                <connections>
                                    <action selector="zoomIn:" target="-1" id="zoomin-act"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Zoom Out" keyEquivalent="-" id="zoomout-item">
                                <connections>
                                    <action selector="zoomOut:" target="-1" id="zoomout-act"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="view-sep"/>
                            <menuItem title="Scroll to Crashed Thread" id="scroll-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="scrollToTarget:" target="-1" id="scroll-act"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Window" id="window-item">
                    <menu key="submenu" title="Window" systemMenu="window" id="window-menu">
                        <items>
                            <menuItem title="Minimize" keyEquivalent="m" id="minimize-item">
                                <connections>
                                    <action selector="performMiniaturize:" target="-1" id="minimize-act"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Zoom" id="zoom-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="performZoom:" target="-1" id="zoom-act"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="window-sep1"/>
                            <menuItem title="Devices" keyEquivalent="d" id="devices-item">
                                <connections>
                                    <action selector="showDevices:" target="app-delegate" id="devices-act"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="window-sep2"/>
                            <menuItem title="Bring All to Front" id="front-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="arrangeInFront:" target="-1" id="front-act"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Help" id="help-item">
                    <menu key="submenu" title="Help" systemMenu="help" id="help-menu">
                        <items>
                            <menuItem title="SYM Help" keyEquivalent="?" id="help-sym">
                                <connections>
                                    <action selector="showHelp:" target="-1" id="help-act"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
            </items>
            <point key="canvasLocation" x="140" y="50"/>
        </menu>
    </objects>
</document>
